# ============================================================
# MediSahel V3 — Variables d'environnement
# ============================================================
# Copiez ce fichier en .env puis remplissez les valeurs :
#   cp .env.example .env
#   nano .env
#   chmod 600 .env
# ============================================================

# ------------------------------------------------------------
# BASE DE DONNÉES POSTGRESQL
# ------------------------------------------------------------
# Ces 3 variables sont utilisées par le container PostgreSQL
# pour créer la base au premier démarrage.
POSTGRES_DB=medisahel
POSTGRES_USER=medisahel_user
POSTGRES_PASSWORD=CHANGEZ_MOI_mot_de_passe_fort

# ------------------------------------------------------------
# CONNEXION PRISMA (utilisée par l'app Node)
# ------------------------------------------------------------
# En Docker, l'hôte est "db" (le nom du service dans docker-compose).
# En natif, ce serait "localhost".
DATABASE_URL=postgresql://medisahel_user:CHANGEZ_MOI_mot_de_passe_fort@db:5432/medisahel?schema=public

# ------------------------------------------------------------
# SÉCURITÉ JWT
# ------------------------------------------------------------
# Générez ces secrets avec : openssl rand -hex 64
# ⚠️ NE JAMAIS PARTAGER CES VALEURS
JWT_SECRET=CHANGEZ_MOI_generez_avec_openssl_rand_hex_64
JWT_REFRESH_SECRET=CHANGEZ_MOI_generez_avec_openssl_rand_hex_64

# ------------------------------------------------------------
# ENVIRONNEMENT
# ------------------------------------------------------------
NODE_ENV=production
PORT=3000
